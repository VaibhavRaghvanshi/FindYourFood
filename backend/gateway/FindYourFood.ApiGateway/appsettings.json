{
  "Tokens": {
    "Issuer": "https://identity.findyourfood.local",
    "Audience": "findyourfood-local",
    "PublicKeyPath": ""
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-staff-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "identity-write",
        "MaxRequestBodySize": 16384,
        "Match": {
          "Path": "/api/v1/identity/staff/login",
          "Methods": ["POST"]
        },
        "Transforms": [{ "X-Forwarded": "Set" }]
      },
      "identity-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "identity-write",
        "MaxRequestBodySize": 16384,
        "Match": {
          "Path": "/api/v1/identity/register",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "identity-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "identity-write",
        "MaxRequestBodySize": 16384,
        "Match": {
          "Path": "/api/v1/identity/login",
          "Methods": [
            "POST"
          ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      },
      "identity-profile": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/v1/identity/me",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Set"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": {
          "ActivityTimeout": "00:00:15"
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "local": {
            "Address": "http://localhost:5101/"
          }
        }
      }
    }
  }
}
